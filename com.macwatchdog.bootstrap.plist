<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.macwatchdog.bootstrap</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__SUPPORT_DIR__/watchdog-bootstrap.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>__CHECK_INTERVAL__</integer>
  <key>StandardOutPath</key>
  <string>__SUPPORT_DIR__/bootstrap.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__SUPPORT_DIR__/bootstrap.launchd.log</string>
</dict>
</plist>
