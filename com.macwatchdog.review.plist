<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.macwatchdog.review</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__WATCHDOG_DIR__/review.sh</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__WATCHDOG_DIR__/review.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__WATCHDOG_DIR__/review.launchd.log</string>
</dict>
</plist>
